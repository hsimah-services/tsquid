{
  "name": "tsquid-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "relay-compiler && tsc --noEmit && vite build",
    "preview": "vite preview",
    "relay": "relay-compiler",
    "relay:watch": "relay-compiler --watch",
    "routes": "tsquid-codegen routes.json src/routes/__generated__/routes.ts",
    "routes:check": "tsquid-codegen routes.json src/routes/__generated__/routes.ts --check",
    "schema": "node scripts/fetch-schema.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0 && tsquid-check-architecture",
    "lint:fix": "eslint src --fix --max-warnings 0 && tsquid-check-architecture",
    "check": "pnpm lint && pnpm build",
    "test": "pnpm check"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.0",
    "@astryxdesign/theme-neutral": "0.6.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tsquid/routes": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-relay": "^21.0.1",
    "react-router": "^8.3.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.0",
    "@tsquid/codegen": "workspace:*",
    "@tsquid/eslint-plugin": "workspace:*",
    "@tsquid/vite": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-relay": "^21.0.1",
    "eslint": "^10.10.0",
    "graphql": "^17.0.2",
    "relay-compiler": "^21.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  }
}
